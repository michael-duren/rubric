// Command tui runs the terminal interface.
package main

import (
	"context"
	"errors"
	"fmt"
	"os"
	"os/signal"

	tea "charm.land/bubbletea/v2"
{{- if .Database}}
	{{.DriverImport}}
{{- end}}

	{{quote (print .Config.Project.Module "/internal/config")}}
{{- if .Database}}
	{{quote (print .Config.Project.Module "/internal/store")}}
{{- end}}
	{{quote (print .Config.Project.Module "/internal/tui")}}
)

func main() {
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt)
	err := run(ctx)
	stop()
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
}

func run(ctx context.Context) {{if .Database}}(err error){{else}}error{{end}} {
{{- if .Database}}
	settings, err := config.Load(os.Getenv("APP_CONFIG_FILE"), os.LookupEnv)
	if err != nil {
		return err
	}
	st, err := store.Open(settings.DatabaseURL)
	if err != nil {
		return err
	}
	defer func() {
		err = errors.Join(err, st.Close())
	}()
	check := st.Ping
{{- else}}
	if _, err := config.Load(os.Getenv("APP_CONFIG_FILE"), os.LookupEnv); err != nil {
		return err
	}
	var check func(context.Context) error
{{- end}}
	_, err {{if not .Database}}:{{end}}= tea.NewProgram(tui.New(ctx, check), tea.WithContext(ctx)).Run()
	if errors.Is(err, tea.ErrProgramKilled) || errors.Is(err, tea.ErrInterrupted) {
		return nil
	}
	return err
}
