// Package tui implements the application's terminal interface.
package tui

import (
	"context"
	"strings"

	tea "charm.land/bubbletea/v2"
)

type checkedMsg struct {
	err error
}

// Model is the terminal UI state; construct it with New.
type Model struct {
	ctx    context.Context
	check  func(context.Context) error
	status string
	width  int
	height int
}

// New returns a model that runs check, when non-nil, as its first command.
func New(ctx context.Context, check func(context.Context) error) Model {
	status := "Ready."
	if check != nil {
		status = "Checking readiness..."
	}
	return Model{ctx: ctx, check: check, status: status}
}

// Init starts the readiness check when one was supplied.
func (m Model) Init() tea.Cmd {
	if m.check == nil {
		return nil
	}
	ctx, check := m.ctx, m.check
	return func() tea.Msg {
		if err := ctx.Err(); err != nil {
			return checkedMsg{err: err}
		}
		return checkedMsg{err: check(ctx)}
	}
}

// Update applies msg and returns the next model and command.
func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	switch msg := msg.(type) {
	case tea.KeyPressMsg:
		switch msg.String() {
		case "q", "esc", "ctrl+c":
			return m, tea.Quit
		}
	case tea.WindowSizeMsg:
		m.width, m.height = max(msg.Width, 0), max(msg.Height, 0)
	case checkedMsg:
		if msg.err != nil {
			m.status = "Not ready: " + msg.err.Error()
		} else {
			m.status = "Ready."
		}
	}
	return m, nil
}

// View renders the status and key help, clipped to the window width once it is known.
func (m Model) View() tea.View {
	lines := []string{m.status, "Press q to quit."}
	if m.width > 0 {
		for i, line := range lines {
			if r := []rune(line); len(r) > m.width {
				lines[i] = string(r[:m.width])
			}
		}
	}
	return tea.NewView(strings.Join(lines, "\n") + "\n")
}
