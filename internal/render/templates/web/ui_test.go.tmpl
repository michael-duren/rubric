//go:build e2e

package e2e

import (
	"net/http/httptest"
	"testing"

	"github.com/mxschmitt/playwright-go"

	{{quote (print .Config.Project.Module "/internal/httpserver")}}
)

func TestCounterAndToggle(t *testing.T) {
	server := httptest.NewServer(httpserver.New(nil))
	defer server.Close()
	pw, err := playwright.Run()
	if err != nil {
		t.Fatalf("start Playwright; run the setup-e2e command first: %v", err)
	}
	defer func() {
		if err := pw.Stop(); err != nil {
			t.Error(err)
		}
	}()
	browser, err := pw.Chromium.Launch()
	if err != nil {
		t.Fatalf("launch Chromium; run the setup-e2e command first: %v", err)
	}
	defer func() {
		if err := browser.Close(); err != nil {
			t.Error(err)
		}
	}()
	page, err := browser.NewPage()
	if err != nil {
		t.Fatal(err)
	}
	if _, err := page.Goto(server.URL); err != nil {
		t.Fatal(err)
	}
	expect := playwright.NewPlaywrightAssertions()
	if err := page.Locator("#increment").Click(); err != nil {
		t.Fatal(err)
	}
	if err := expect.Locator(page.Locator("#count")).ToHaveText("1"); err != nil {
		t.Fatalf("htmx did not swap the counter: %v", err)
	}
	details := page.Locator("#details")
	if err := expect.Locator(details).ToBeHidden(); err != nil {
		t.Fatal(err)
	}
	if err := page.Locator("#toggle").Click(); err != nil {
		t.Fatal(err)
	}
	if err := expect.Locator(details).ToBeVisible(); err != nil {
		t.Fatalf("Alpine.js did not toggle the details: %v", err)
	}
}
