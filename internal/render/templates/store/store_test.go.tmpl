package store

import (
	"context"
	"errors"
	"testing"

	"github.com/DATA-DOG/go-sqlmock"
	_ "github.com/jackc/pgx/v5/stdlib"
)

func mockStore(t *testing.T) (*Store, sqlmock.Sqlmock) {
	t.Helper()
	db, mock, err := sqlmock.New(sqlmock.QueryMatcherOption(sqlmock.QueryMatcherEqual), sqlmock.MonitorPingsOption(true))
	if err != nil {
		t.Fatal(err)
	}
	store, err := New(db)
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() {
		if err := mock.ExpectationsWereMet(); err != nil {
			t.Error(err)
		}
	})
	return store, mock
}

func TestGetBindsParameter(t *testing.T) {
	store, mock := mockStore(t)
	mock.ExpectQuery(getSQL).WithArgs("name").WillReturnRows(sqlmock.NewRows([]string{"value"}).AddRow("rubric"))
	got, err := store.Get(t.Context(), "name")
	if err != nil || got != "rubric" {
		t.Fatalf("Get = %q, %v", got, err)
	}
}

func TestGetNotFound(t *testing.T) {
	store, mock := mockStore(t)
	mock.ExpectQuery(getSQL).WithArgs("missing").WillReturnRows(sqlmock.NewRows([]string{"value"}))
	if _, err := store.Get(t.Context(), "missing"); !errors.Is(err, ErrNotFound) {
		t.Fatalf("err = %v", err)
	}
}

func TestGetScanError(t *testing.T) {
	store, mock := mockStore(t)
	mock.ExpectQuery(getSQL).WithArgs("k").WillReturnRows(sqlmock.NewRows([]string{"value"}).AddRow(nil))
	if _, err := store.Get(t.Context(), "k"); err == nil || errors.Is(err, ErrNotFound) {
		t.Fatalf("err = %v", err)
	}
}

func TestPutBindsParameters(t *testing.T) {
	store, mock := mockStore(t)
	mock.ExpectExec(putSQL).WithArgs("k", "v'; --").WillReturnResult(sqlmock.NewResult(0, 1))
	if err := store.Put(t.Context(), "k", "v'; --"); err != nil {
		t.Fatal(err)
	}
}

func TestPutError(t *testing.T) {
	store, mock := mockStore(t)
	want := errors.New("constraint violated")
	mock.ExpectExec(putSQL).WithArgs("k", "v").WillReturnError(want)
	if err := store.Put(t.Context(), "k", "v"); !errors.Is(err, want) {
		t.Fatalf("err = %v", err)
	}
}

func TestPingFailure(t *testing.T) {
	store, mock := mockStore(t)
	want := errors.New("connection refused")
	mock.ExpectPing().WillReturnError(want)
	if err := store.Ping(t.Context()); !errors.Is(err, want) {
		t.Fatalf("err = %v", err)
	}
}

func TestCancelled(t *testing.T) {
	store, _ := mockStore(t)
	ctx, cancel := context.WithCancel(context.Background())
	cancel()
	if _, err := store.Get(ctx, "k"); !errors.Is(err, context.Canceled) {
		t.Fatalf("Get = %v", err)
	}
	if err := store.Put(ctx, "k", "v"); !errors.Is(err, context.Canceled) {
		t.Fatalf("Put = %v", err)
	}
}

func TestCloseError(t *testing.T) {
	store, mock := mockStore(t)
	want := errors.New("close failed")
	mock.ExpectClose().WillReturnError(want)
	if err := store.Close(); !errors.Is(err, want) {
		t.Fatalf("err = %v", err)
	}
}

func TestNewRejectsNil(t *testing.T) {
	if _, err := New(nil); err == nil {
		t.Fatal("nil handle accepted")
	}
}

func TestOpenIsLazy(t *testing.T) {
	store, err := Open("postgres://nobody@127.0.0.1:1/unreachable?sslmode=disable&connect_timeout=1")
	if err != nil {
		t.Fatalf("Open contacted the server or failed: %v", err)
	}
	if err := store.Close(); err != nil {
		t.Fatal(err)
	}
}
