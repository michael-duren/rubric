package store

import (
	"context"
	"database/sql"
	"errors"
	"os"
	"path/filepath"
	"testing"

	_ "modernc.org/sqlite"
)

func openTest(t *testing.T) *Store {
	t.Helper()
	schema, err := os.ReadFile(filepath.Join("..", "..", "sql", "schema.sql"))
	if err != nil {
		t.Fatal(err)
	}
	db, err := sql.Open("sqlite", filepath.Join(t.TempDir(), "test.db"))
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() {
		if err := db.Close(); err != nil && !errors.Is(err, sql.ErrConnDone) {
			t.Error(err)
		}
	})
	if _, err := db.Exec(string(schema)); err != nil {
		t.Fatal(err)
	}
	store, err := New(db)
	if err != nil {
		t.Fatal(err)
	}
	return store
}

func TestRoundTrip(t *testing.T) {
	store := openTest(t)
	if err := store.Put(t.Context(), "name", "rubric"); err != nil {
		t.Fatal(err)
	}
	got, err := store.Get(t.Context(), "name")
	if err != nil || got != "rubric" {
		t.Fatalf("Get = %q, %v", got, err)
	}
	if err := store.Ping(t.Context()); err != nil {
		t.Fatal(err)
	}
}

func TestNotFound(t *testing.T) {
	if _, err := openTest(t).Get(t.Context(), "missing"); !errors.Is(err, ErrNotFound) {
		t.Fatalf("err = %v", err)
	}
}

func TestUpsert(t *testing.T) {
	store := openTest(t)
	for _, value := range []string{"one", "two'; DROP TABLE entries; --"} {
		if err := store.Put(t.Context(), "k", value); err != nil {
			t.Fatal(err)
		}
	}
	got, err := store.Get(t.Context(), "k")
	if err != nil || got != "two'; DROP TABLE entries; --" {
		t.Fatalf("Get = %q, %v", got, err)
	}
}

func TestNewRejectsNil(t *testing.T) {
	if _, err := New(nil); err == nil {
		t.Fatal("nil handle accepted")
	}
}

func TestCancelled(t *testing.T) {
	store := openTest(t)
	ctx, cancel := context.WithCancel(context.Background())
	cancel()
	if err := store.Put(ctx, "k", "v"); !errors.Is(err, context.Canceled) {
		t.Fatalf("Put = %v", err)
	}
	if _, err := store.Get(ctx, "k"); !errors.Is(err, context.Canceled) {
		t.Fatalf("Get = %v", err)
	}
}

func TestClose(t *testing.T) {
	store, err := Open(filepath.Join(t.TempDir(), "lazy.db"))
	if err != nil {
		t.Fatal(err)
	}
	if err := store.Close(); err != nil {
		t.Fatal(err)
	}
	if err := store.Ping(t.Context()); err == nil {
		t.Fatal("ping succeeded after close")
	}
}
