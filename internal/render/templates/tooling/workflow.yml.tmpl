name: ci

on:
  push:
  pull_request:

permissions:
  contents: read

jobs:
  check:
    runs-on: ubuntu-latest
[[- if .Integration]]
    services:
      postgres:
        image: postgres:17.6
        env:
          POSTGRES_DB: rubric_test
          POSTGRES_HOST_AUTH_METHOD: trust
        ports:
          - 5432:5432
        options: >-
          --health-cmd "pg_isready -U postgres -d rubric_test"
          --health-interval 5s
          --health-timeout 5s
          --health-retries 10
[[- end]]
    steps:
      - uses: actions/checkout@08c6903cd8c0fde910a37f88322edcfb5dd907a8
      - uses: actions/setup-go@44694675825211faa026b3c33043df3e48a5fa00
        with:
          go-version: "[[.GoVersion]]"
      - name: Download modules
        run: go mod download
      - name: Build
        run: [[.Run "build"]]
      - name: Test
        run: [[.Run "test"]]
[[- if .Lint]]
      - name: Lint
        run: [[.Run "lint"]]
[[- end]]
[[- if .Generate]]
      - name: Check generated code
        run: [[.Run "generate"]] && git diff --exit-code
[[- end]]
[[- if .Templ]]
      - name: Check generated templ code
        run: [[.Run "generate-templ"]] && git diff --exit-code
[[- end]]
[[- if .Integration]]
      - name: Integration tests
        env:
          TEST_DATABASE_URL: postgres://postgres@127.0.0.1:5432/rubric_test?sslmode=disable
        run: [[.Run "test-integration"]]
[[- end]]
[[- if .E2E]]
      - name: Install Playwright browsers
        run: go run [[.PlaywrightLauncher]] install --with-deps chromium
      - name: End-to-end tests
        run: [[.Run "test-e2e"]]
[[- end]]
